[Unit]
Description=VERITUT ops (SvelteKit · adapter-node)
After=network-online.target veritut-api.service
Wants=network-online.target

[Service]
Type=simple
User=veritut
Group=veritut
WorkingDirectory=/srv/veritut/app/apps/ops
EnvironmentFile=/etc/veritut/ops.env
ExecStart=/usr/bin/node build/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=384M

[Install]
WantedBy=multi-user.target
