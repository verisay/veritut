      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://vt-portal.dev-fethi.entra.net/*##http://localhost:5240/*" },
      "defaultClientScopes": ["profile", "email"]
    }
  ],
  "users": [
