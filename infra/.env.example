# VERITUT dev ortamı — infra/.env olarak kopyalayın ve sırları doldurun.
# Gerçek değerler ASLA commit edilmez (pre-commit secret taraması da kontrol eder).
PROJECT=veritut
SLUG=vt
NODE_ENV=development
LOG_LEVEL=debug

# Postgres (uygulama DB + init script'in açtığı keycloak / veritut_tfstate)
POSTGRES_USER=veritut
POSTGRES_DB=veritut
POSTGRES_PASSWORD=<PLACEHOLDER>
DATABASE_URL=postgres://veritut:<PLACEHOLDER>@postgres:5432/veritut
KC_DB_PASSWORD=<PLACEHOLDER>
TFSTATE_DB_PASSWORD=<PLACEHOLDER>

REDIS_URL=redis://redis:6379
# Status app — yalnız status:* okuyan ACL kullanıcısı (infra/redis/users.acl)
STATUS_REDIS_URL=redis://status:status-dev-only@redis:6379

API_PORT=4400
API_URL=http://veritut-api:4400

# Yüzeyler (dev filo host'ları)
PORTAL_URL=https://vt-portal.dev-fethi.entra.net
OPS_URL=https://vt-ops.dev-fethi.entra.net
STATUS_URL=https://vt-status.dev-fethi.entra.net
CORS_ORIGIN=https://vt-portal.dev-fethi.entra.net,https://vt-ops.dev-fethi.entra.net

# Keycloak (D6) — tarayıcı public'e gider, API iç ağdan konuşur
KC_PUBLIC_URL=https://vt-kimlik.dev-fethi.entra.net
KC_INTERNAL_URL=http://veritut-keycloak:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<PLACEHOLDER>
OIDC_MUSTERI_CLIENT_ID=portal
OIDC_MUSTERI_CLIENT_SECRET=dev-portal-secret-change-me
OIDC_OPS_CLIENT_ID=ops
OIDC_OPS_CLIENT_SECRET=dev-ops-secret-change-me

# openssl rand -hex 32
SESSION_ENC_KEY=<PLACEHOLDER>
# openssl rand -hex 24
INTERNAL_TOKEN=<PLACEHOLDER>

# OpenTofu state şifreleme parolası (yalnız runner; ≥16 karakter) — openssl rand -hex 24
TFSTATE_ENC_PASSPHRASE=<PLACEHOLDER>
# Runner'da etkin tedarikçi driver'ları
PROVIDER_DRIVERS=mock,hetzner

# node tools/gen-runner-keys.mjs — açık anahtar API'ye, ÖZEL anahtar yalnız runner'a (D12)
RUNNER_PUBLIC_KEY=<PLACEHOLDER>
RUNNER_PRIVATE_KEY=<PLACEHOLDER>

# S3 uyumlu depolama — dev: minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=veritut-dev
S3_SECRET_KEY=<PLACEHOLDER>
S3_BUCKET=veritut-dev

# Faturalama omurgası (D17) — Core para toplamaz
BILLING_PROVIDER=mock
FOSSBILLING_URL=
FOSSBILLING_API_KEY=
BILLING_WEBHOOK_SECRET=<PLACEHOLDER>
# Alertmanager webhook token'ı
ALERTMANAGER_TOKEN=<PLACEHOLDER>
# Destek masası (D18)
TICKET_PROVIDER=mock
ZAMMAD_URL=
ZAMMAD_TOKEN=
TICKET_WEBHOOK_SECRET=<PLACEHOLDER>
