# VERITUT runner imajı (D5/D10): Node 22 + OpenTofu + Ansible + Restic.
# Tedarikçi kimlik bilgilerini açan tek süreç burada koşar; API/worker imajından AYRI tutulur.
# INSTALL_IAC=0 ile yalnız Node (ağ kısıtlı ortamda hızlı build; echo çalıştırması için yeter).
FROM node:22-bookworm-slim
ARG INSTALL_IAC=1
ARG OPENTOFU_VERSION=1.8.5
ENV COREPACK_DEFAULT_TO_LATEST=0
RUN corepack enable && corepack prepare pnpm@10.17.0 --activate
ENV PNPM_HOME=/pnpm CI=1
ENV PATH="$PNPM_HOME:$PATH"
RUN pnpm config set store-dir /pnpm/store --global
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ git ca-certificates curl unzip openssh-client \
    && if [ "$INSTALL_IAC" = "1" ]; then \
         apt-get install -y --no-install-recommends ansible restic \
         && curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_amd64.zip" -o /tmp/tofu.zip \
         && unzip -o /tmp/tofu.zip tofu -d /usr/local/bin && rm /tmp/tofu.zip && tofu version \
         && ansible-galaxy collection install 'community.docker:>=3.10.0,<5' 'community.general:>=8.0.0,<10' -p /usr/share/ansible/collections ; \
       fi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
