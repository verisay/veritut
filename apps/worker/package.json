{
  "name": "@veritut/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "sh -c 'F=$(find src -name \"*.test.ts\"); [ -n \"$F\" ] && tsx --test $F || echo \"test dosyası yok\"'"
  },
  "dependencies": {
    "@veritut/types": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
