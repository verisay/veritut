{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/output/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
